########################################################################
# MagicAI v11.20 — PRODUCTION CONTAINER ENVIRONMENT CONTRACT
########################################################################
#
# Target runtime : Cloudflare Container (single instance)
#                  nginx + PHP-FPM + queue worker + scheduler (supervisord)
# Application    : Laravel 10.50.2 / PHP 8.4 (php:8.4-fpm-alpine)
# Source of truth: repository .env.example + completed read-only audit
#
# ── HOW TO USE ────────────────────────────────────────────────────────
#   cp deploy/container.env.example  <your secret store / env file>
#   Fill every blank. Do NOT commit the filled copy.
#
# ── CRITICAL: config:cache FREEZES EVERYTHING ──────────────────────────
#   docker/entrypoint.sh:34 runs `php artisan config:cache` BEFORE
#   supervisord. Every env() call is evaluated once at boot and written
#   to bootstrap/cache/config.php. Variables are IMMUTABLE for the life
#   of the container. Rotating any value requires a container restart.
#   This contract must be complete and correct on FIRST boot.
#
# ── SECRETS ───────────────────────────────────────────────────────────
#   Every line marked  PRODUCTION SECRET  must be blank in this file and
#   supplied at container start. .dockerignore excludes .env/.env.*, so
#   nothing is baked into the image — but this .example file IS copied
#   into the image by `COPY . .` (Dockerfile:87). It therefore contains
#   NO real values by design. Keep it that way.
#
# ── EXPLICITLY OUT OF SCOPE ───────────────────────────────────────────
#   * No Hyperdrive variable. Hyperdrive is a Cloudflare *Workers*
#     binding; it is not resolvable from PHP-FPM and Laravel 10 cannot
#     parse the `mysql://…?hyperdrive=…` URL form. The container reaches
#     PlanetScale over ordinary outbound TCP. The Hyperdrive config
#     (id f6a3c7a53ce24305ac8910f0eb740c63) is intentionally unused.
#   * No SiteGround variable. The repository contains zero SiteGround
#     references (verified by full-tree grep).
########################################################################


########################################################################
# 1) APPLICATION CORE — REQUIRED
########################################################################
APP_NAME="MagicAI"
APP_ENV=production
APP_DEBUG=false

# PRODUCTION SECRET — generate per environment, never reuse a dev key.
#   php artisan key:generate --show
# Encrypts session cookies and all encrypted model attributes.
APP_KEY=

# REQUIRED — public HTTPS origin. Drives config('app.url'), asset URLs,
# the `public`/`uploads`/`thumbs` filesystem disk URLs, OAuth callbacks
# and payment return URLs. MUST be https:// — the Worker terminates TLS.
APP_URL=https://ai.alindadecor.com

# OPTIONAL — MUST NOT be "Demo".
# config/app.php:49 defaults to null (safe). Setting it to "Demo" makes
# the daily `app:clear-job-table` task run
#   DB::table('jobs')->truncate()  AND  DB::table('failed_jobs')->truncate()
#   (Clear/ClearJobTableCommand.php:37-39) which destroys the DB queue.
# Leave blank.
APP_STATUS=

# REQUIRED — Cloudflare collects container logs from stdout/stderr.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null


########################################################################
# 2) DATABASE — PlanetScale MySQL — REQUIRED
#
# All five DB_* values are REQUIRED. There is no working default: the
# mysql block in config/database.php:44-62 defaults to 127.0.0.1/forge.
########################################################################
DB_CONNECTION=mysql

# REQUIRED — PlanetScale hostname, e.g. aws.connect.psdb.cloud
# or <region>.connect.psdb.cloud. NOT a Hyperdrive host.
DB_HOST=

DB_PORT=3306

# REQUIRED — target database.
DB_DATABASE=magic-ai

# PRODUCTION SECRET — PlanetScale username.
DB_USERNAME=

# PRODUCTION SECRET — PlanetScale password.
DB_PASSWORD=

# OPTIONAL — leave EMPTY. config/database.php:51 defaults to ''. A
# non-empty value makes PDO prefer a unix socket over TCP, which will
# break the container.
DB_SOCKET=

# Leave EMPTY. config/database.php:45 reads this as a standard PDO DSN;
# it is NOT the Cloudflare Hyperdrive URL form.
DATABASE_URL=


########################################################################
# 2b) *** MYSQL_ATTR_SSL_CA — REQUIRED (P0) ***
#
# WHY THIS IS MANDATORY
#   PlanetScale refuses plaintext MySQL. config/database.php:61-63 is
#   the ONLY TLS lever the app has:
#
#     'options' => extension_loaded('pdo_mysql') ? array_filter([
#         PDO::MYSQL_ATTR_SSL_CA => env('MYSQL_ATTR_SSL_CA'),
#     ]) : [],
#
#   array_filter() DROPS the key when the variable is null. With this
#   variable unset, zero PDO options are passed and the connection is
#   attempted in plaintext -> rejected. The container then fails
#   Helper::dbConnectionStatus() (app/Helpers/Classes/Helper.php:176-185)
#   and every request redirects to /install.
#
#   The commented-out `encrypt` / `trust_server_certificate` options at
#   config/database.php:92-93 are sqlsrv-only and are NOT a substitute.
#
# EXPECTED IN-CONTAINER CA BUNDLE PATH
#   /etc/ssl/certs/ca-certificates.crt        <-- set below
#
#   This is the Alpine (php:8.4-fpm-alpine) location. The Dockerfile does
#   NOT install `ca-certificates` explicitly and does NOT set
#   `openssl.cafile` — production.ini (Dockerfile:126-135) has zero
#   openssl directives. The bundle arrives only transitively via `curl`
#   (Dockerfile:43). VERIFY BEFORE FIRST DEPLOY:
#
#     docker run --rm <image> sh -c 'ls -l /etc/ssl/certs/ca-certificates.crt'
#
#   If the file is absent, either add `ca-certificates` to the apk list
#   in Dockerfile:39-77, or mount a bundle and point this at it.
#
# NOTE: this is a path, not a secret.
########################################################################
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt


########################################################################
# 3) CACHE / SESSION / QUEUE — REQUIRED
#
# These three are fine as `file` ONLY because the deployment is a single
# container instance. If you ever scale beyond 1 replica, all three must
# move to a shared store (the DB queue's retry lock, the
# WithoutOverlapping mutexes in SendConfirmationEmail.php:43-46 and
# SendPaymentConfirmationEmail.php:48-51, and the `crontab_check` flag
# all assume one shared filesystem).
########################################################################
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# OPTIONAL — already defaults to true (config/session.php:171). Set
# explicitly: the Worker terminates TLS, cookies must be Secure.
SESSION_SECURE_COOKIE=true

# OPTIONAL — leave blank unless serving a parent domain. Bare host works.
SESSION_DOMAIN=

# REQUIRED — must stay `database`. app/Jobs has 12 jobs and the jobs
# table is created by migration. Do NOT use `sync`.
QUEUE_CONNECTION=database

# OPTIONAL — leave default. The failed-job driver writes to the
# `failed_jobs` table in the same database.
QUEUE_FAILED_DRIVER=

# REQUIRED — keep `log`. config/broadcasting.php:18 defaults to
# `pusher`, but `grep -rE 'ShouldBroadcast|broadcast\(' app/` returns
# ZERO matches: no event is ever broadcast. `pusher` would be a
# no-op dependency at best.
BROADCAST_DRIVER=log


########################################################################
# 4) FILESYSTEM / CLOUDFLARE R2 — REQUIRED
#
# Env names must stay EXACTLY as read by the `r2` disk in
# config/filesystems.php:101-112. Renaming any of these silently falls
# back to the local disk.
#
# These are used as a plain S3-compatible disk
# (league/flysystem-aws-s3-v3 3.29.0) via API keys. Do NOT convert
# them to a Workers R2 binding: the app is PHP, not a Worker.
#
# ======================================================================
# *** PENDING REPLACEMENT — DO NOT TRUST THE VALUES BELOW ***
# ======================================================================
# Every value in this block is inherited from the repository .env and
# still points at the PREVIOUS Cloudflare account. They are retained
# verbatim only so the variable names stay reviewable — they are NOT
# approved for the unified production account.
#
# Evidence that R2 was never live in the old deployment: the SiteGround
# production .env (siteground-emergency-backup/.../public_html/.env)
# has ALL SEVEN CLOUDFLARE_R2_* keys EMPTY. R2 has never carried
# production traffic.
#
# ACTION REQUIRED before first deploy: issue fresh R2 API credentials
# on the unified account (b31b09bae0f6757a9aa03cfd03308ff5) and
# re-verify the bucket name, endpoint hostname and public URL against
# that account's R2 dashboard. Do not assume the values below carry
# over — an access key is scoped to the account that issued it.
#
# Note: the endpoint below already embeds account b31b09bae…, so only
# the CREDENTIALS and the bucket/URL naming are in question. If the
# unified account turns out to be a different ID, the endpoint and URL
# must change too.
# ======================================================================
########################################################################
CLOUDFLARE_R2_BUCKET=magicai-pixury

CLOUDFLARE_R2_ENDPOINT=https://b31b09bae0f6757a9aa03cfd03308ff5.r2.cloudflarestorage.com

CLOUDFLARE_R2_URL=https://pub-2c0d06ae80bf416190c8b8d3a63b3b72.r2.dev

# PRODUCTION SECRET — R2 access key id (32 hex chars).
CLOUDFLARE_R2_ACCESS_KEY_ID=

# PRODUCTION SECRET — R2 secret access key (64 hex chars).
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# OPTIONAL — R2 is globally replicated; this value is cosmetic.
# `auto` is also valid.
CLOUDFLARE_R2_DEFAULT_REGION=us-east-1

# OPTIONAL — leave false. R2 uses virtual-hosted style.
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false

# OPTIONAL — this disk is largely INERT in this application.
# 40+ call sites select the active disk from the DATABASE column
# `settings_two.ai_image_storage` (e.g. CommonController.php:150,160,
# 285,320,330; StorageController.php:36,40) — not from this variable.
# Setting FILESYSTEM_DISK=r2 changes nothing until that row is written.
# Set post-deploy: Admin -> Config -> Storage.
FILESYSTEM_DISK=public

# KNOWN ISSUE — do not "fix" without reading the audit:
# config/filesystems.php:47 builds the `public` disk URL as
# APP_URL . '/public', a stray segment that does not match nginx's
# root /var/www/public (docker/nginx.conf:29). Pre-existing, unchanged
# by this contract.


########################################################################
# 5) MAIL — REQUIRED if any transactional mail must send
#
# 12 queued jobs send mail (SendEmail, SendPasswordResetEmail,
# SendConfirmationEmail, SendPaymentConfirmationEmail, team invites,
# gateway customer jobs). Password reset and payment confirmation are
# user-facing and cannot be skipped.
#
# config/mail.php reads MAIL_MAILER (not the legacy MAIL_DRIVER, which
# Laravel 10 ignores — see section 9).
########################################################################
MAIL_MAILER=smtp

# REQUIRED — the live SMTP host. Do NOT ship smtp.mailtrap.io or any
# sandbox host; the current .env uses one and it is dev-only.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=

# OPTIONAL — a real From address is required by most SMTP providers.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"


########################################################################
# 6) AI PROVIDERS — OPTIONAL (fallback only; the database wins)
#
# app/Helpers/Classes/Traits/HasApiKeys.php resolves every provider key
# from the `settings` / `settings_two` TABLES and then overwrites the
# config at runtime, e.g. HasApiKeys.php:115-117. Because
# entrypoint.sh:34 runs config:cache, these env values are frozen into
# the cached config and are used ONLY when the matching DB column is
# empty.
#
# Consequence: on a fresh deployment NO AI generation works until keys
# are entered in Admin -> Settings. These blanks are safe and expected.
# AWS Bedrock is the one exception — it reads the AWS_* values directly
# (app/Providers/AwsServiceProvider.php:18-24) and has no DB column.
########################################################################
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_REQUEST_TIMEOUT=

GEMINI_API_KEY=
GEMINI_REQUEST_TIMEOUT=

DEEPSEEK_API_KEY=
DEEPSEEK_REQUEST_TIMEOUT=

# NOTE — not listed above because it is a defect, not a feature:
# config/xai.php:12 reads env('OPENAI_API_KEY') for the xAI/Grok key.
# Harmless only because the DB column overrides it. Do not "fix" by
# adding XAI_API_KEY here.

# OPTIONAL — AWS Bedrock (Claude / Stability via Bedrock) and the `s3`
# disk. Leave entirely blank if Bedrock is not used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=


########################################################################
# 7) PAYMENTS — OPTIONAL (per enabled gateway)
#
# NOT required for the container to boot. The `plans` table ships EMPTY
# on a fresh database (no migration inserts plan rows; only the admin
# AI Plan Wizard does — AiPlanWizardService.php:365), so checkout is
# blank until plans are created regardless of these keys.
########################################################################
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=

CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en

PAYPAL_LIVE_APP_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_LOCALE=US
PAYPAL_MODE=live

# --- DEVELOPMENT ONLY — MUST BE ABSENT IN PRODUCTION (see section 9) ---
#PAYPAL_SANDBOX_CLIENT_ID=
#PAYPAL_SANDBOX_CLIENT_SECRET=


########################################################################
# 8) OPTIONAL FEATURE KEYS
########################################################################

# Social login (OAuth). auth/socialite.php reads these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_BUNDLE_ID=

# Human Agent realtime. NOTE: the Human Agent feature is NOT functional
# in this build — app/Extensions/ is empty (no `chatbot` /
# `chatbot-agent` extension) and User::isActiveHumanAgent() has zero
# call sites. Set this only if the extensions are added later.
ABLY_KEY=

# Pusher. Listed for completeness. config/broadcasting.php reads these
# but AppServiceProvider.php:108-109 overrides them from the DB, and no
# event is ever broadcast. BROADCAST_DRIVER=log makes this a no-op.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# reCAPTCHA. DB-backed (app/Models/Setting.php:26-38); env is fallback.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# MagicAI updater channel. `config/installer.php:131` sets
# updaterEnabled => 'false', so the updater is OFF and these endpoints
# are never called. Keep 'customer' if it is ever enabled.
MAGICAI_USER_TYPE=customer

# Leave blank unless a separate SPA origin needs stateful API cookies.
# Defaults to APP_URL.
SANCTUM_STATEFUL_DOMAINS=

# OPTIONAL — error reporting. Leave blank to disable.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=


########################################################################
# 9) MUST BE ABSENT IN PRODUCTION
#
# Unset, or commented out. Nothing below should reach the container.
########################################################################
# --- Local development sandbox ---
#DEBUGBAR_ENABLED=          # barryvdh/laravel-debugbar, dev-only
#DEBUGBAR_EDITOR=
#DEBUGBAR_THEME=
#DEBUGBAR_LOCAL_SITES_PATH=
#DEBUGBAR_REMOTE_SITES_PATH=
#DEBUGBAR_OPEN_STORAGE=
#SHOW_LOAD_TIME=
#MEMCACHED_HOST=

# --- Payment sandboxes ---
#PAYPAL_SANDBOX_CLIENT_ID=
#PAYPAL_SANDBOX_CLIENT_SECRET=
#PAYPAL_SANDBOX_APP_ID=

# --- Exposed API docs: publishes a full route listing + schemas ---
#L5_SWAGGER_GENERATE_ALWAYS=
#OH_DEAR_HEALTH_CHECK_SECRET=

# --- Not used by this deployment ---
#MINIFY_ENABLED=             # fahlisaputra/laravel-minify
#MINIFY_CSS_SEMICOLON=
#MINIFY_JS_SEMICOLON=
#MINIFY_OBFUSCATE=
#MINIFY_REMOVE_COMMENTS=
#MINIFY_ASSETS_ENABLED=
#OCTANE_ENABLED=            # laravel/octane is installed but unused
#OCTANE_SERVER=
#OCTANE_HTTPS=
#REDIS_HOST=                # queue/cache/session are on file + database
#REDIS_PORT=
#REDIS_PASSWORD=
#DYNAMODB_CACHE_TABLE=
#QUEUE_DRIVER=              # INERT: Laravel 10 ignores this entirely.
#                           # Only QUEUE_CONNECTION is read
#                           # (config/queue.php:16). Shipping it
#                           # alongside QUEUE_CONNECTION is a trap.

# --- MUST NOT be set to "Demo" (see APP_STATUS in section 1) ---


########################################################################
# 10) NOT VARIABLES — IMAGE/CONTAINER REQUIREMENTS
#
# Recorded here because they are as fatal as a missing env var.
#
# 10.1  A license-state file must exist at storage/app/portal
#       ApplicationStatusRepository::next() (:112-134) redirects EVERY
#       web request to the license page when that file is absent. It is
#       read from Storage::disk('local') (=> storage/app) and is NOT
#       tracked by git. On an ephemeral container filesystem it is
#       missing on every boot. Unresolved (P0).
#
# 10.2  The database must be migrated AND seeded before the container
#       serves traffic. docker/entrypoint.sh runs no migrate and no
#       seed. Intended entry point is `php artisan app:populate-db`
#       (app/Console/Commands/PopulateDb.php:16), which wraps
#       DatabaseManager::migrateAndSeed(). NOT YET RUN.
#
# 10.3  Container healthcheck: GET /api/health on port 8080.
#       Registered at routes/api.php:26 and served by
#       app/Http/Controllers/Api/HealthController.php, which returns
#       {"status":"ok"} with NO database access — it passes against a
#       completely empty database. Do not use it as a readiness signal
#       for migration/seed completion.
#
# 10.4  Required processes (docker/supervisord.conf): php-fpm, nginx,
#       queue, scheduler. All 4 must be RUNNING. Never scale the
#       scheduler past one replica.
#
# 10.5  Listener is 127.0.0.1:9000 (PHP-FPM) behind nginx on :8080.
#       No inbound ports except 8080.
#
# 10.6  Proxy handling needs no change. App\Http\Middleware\TrustProxies
#       sets $proxies = '*' and includes HEADER_X_FORWARDED_PROTO
#       (TrustProxies.php:15,26-30) and is first in the global stack
#       (app/Http/Kernel.php:52), so the Cloudflare edge is honoured.
#
# 10.7  Ephemeral-filesystem caveat. Generated media is written to
#       public/uploads first and only afterwards migrated to R2
#       (CommonController.php:145-168, :316-338). With
#       settings_two.ai_image_storage left at its default, media is
#       served from the container filesystem and is LOST on recycle.
#       ThumbImage() (helpers.php:1222-1288) regenerates local
#       thumbnails on every request and returns a local URL.
#       storage/app/r2-cache is created by the Dockerfile and entrypoint
#       but is referenced by zero lines of application code.
########################################################################
